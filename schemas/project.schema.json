{
  "$defs": {
    "HandbookReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "title",
        "version",
        "path",
        "sha256"
      ],
      "title": "HandbookReference",
      "type": "object"
    },
    "PrdReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "PrdReference",
      "type": "object"
    },
    "StagePlanItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "development",
          "enum": [
            "development",
            "frontend"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "requires_real_model": {
          "default": false,
          "title": "Requires Real Model",
          "type": "boolean"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "sequence"
      ],
      "title": "StagePlanItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "constraints_path": {
      "title": "Constraints Path",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "factory_version": {
      "title": "Factory Version",
      "type": "string"
    },
    "handbooks": {
      "items": {
        "$ref": "#/$defs/HandbookReference"
      },
      "title": "Handbooks",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "prd": {
      "$ref": "#/$defs/PrdReference"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_excludes": {
      "items": {
        "type": "string"
      },
      "title": "Source Excludes",
      "type": "array"
    },
    "stage_plan": {
      "items": {
        "$ref": "#/$defs/StagePlanItem"
      },
      "minItems": 1,
      "title": "Stage Plan",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "name",
    "created_at",
    "factory_version",
    "prd",
    "constraints_path",
    "handbooks",
    "stage_plan",
    "source_excludes"
  ],
  "title": "ProjectRecord",
  "type": "object"
}
